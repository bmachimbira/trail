---
import { Effect } from "effect";
import Layout from "../../layouts/Layout.astro";
import { isTransferError } from "../../lib/http.js";
import { runApp } from "../../lib/runtime.js";
import { type Bundle, FileTransfer } from "../../lib/transfer.js";

const { id } = Astro.params;

const effect = Effect.gen(function* () {
  const transfer = yield* FileTransfer;
  return yield* transfer.bundle(id ?? "");
});
const outcome = await runApp(effect);

let state: "missing" | "expired" | "ok" = "missing";
let bundle: Bundle | undefined;
if (!isTransferError(outcome) && outcome !== undefined) {
  bundle = outcome;
  state = Date.parse(outcome.expiresAt) < Date.now() ? "expired" : "ok";
}
const files = bundle?.files ?? [];
const single = files.length === 1 ? files[0] : undefined;
const title = single ? single.filename : `${files.length} files`;
const totalSize = files.reduce((n, f) => n + f.size, 0);
const downloads = files.reduce((n, f) => n + f.downloads, 0);
if (state === "missing") Astro.response.status = 404;
if (state === "expired") Astro.response.status = 410;

const fmtBytes = (n: number): string => {
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  if (n < 1024 * 1024 * 1024) return `${(n / 1024 / 1024).toFixed(1)} MB`;
  return `${(n / 1024 / 1024 / 1024).toFixed(1)} GB`;
};
const fmtDate = (iso: string): string =>
  new Date(iso).toLocaleString(undefined, {
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
---

<Layout title={bundle ? `${title} — Trail` : "Trail"}>
  {
    state === "ok" && bundle && (
      <article class="share">
        <p class="kicker reveal" style="--i:1">Shared with you</p>
        <h1 class="filename reveal" style="--i:2" title={title}>
          {title}
        </h1>
        <dl class="facts reveal" style="--i:3">
          <div>
            <dt>Size</dt>
            <dd>{fmtBytes(totalSize)}</dd>
          </div>
          <div>
            <dt>Sent</dt>
            <dd>{fmtDate(bundle.uploadedAt)}</dd>
          </div>
          <div>
            <dt>Expires</dt>
            <dd>{fmtDate(bundle.expiresAt)}</dd>
          </div>
          <div>
            <dt>Downloads</dt>
            <dd>{downloads}</dd>
          </div>
        </dl>
        {!single && (
          <ul class="file-rows reveal" style="--i:4">
            {files.map((f) => (
              <li>
                <span class="file-name" title={f.filename}>{f.filename}</span>
                <a class="file-dl mono" href={`/api/files/${f.id}`} download>
                  {fmtBytes(f.size)} ↓
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="actions reveal" style="--i:5">
          {single ? (
            <a class="btn btn-primary" href={`/api/files/${single.id}`} download>
              Download<span class="mono dl-size">· {fmtBytes(single.size)}</span>
            </a>
          ) : (
            <a class="btn btn-primary" href={`/api/bundles/${bundle.id}/zip`} download>
              Download all<span class="mono dl-size">· {fmtBytes(totalSize)} zip</span>
            </a>
          )}
        </div>
        <p class="quiet mono reveal" style="--i:6">
          this link expires {fmtDate(bundle.expiresAt)} — after that, it&rsquo;s gone
        </p>
      </article>
    )
  }
  {
    state === "expired" && (
      <article class="share">
        <p class="kicker reveal" style="--i:1">Expired</p>
        <h1 class="filename reveal" style="--i:2">This link has expired.</h1>
        <p class="plain reveal" style="--i:3">
          The file&rsquo;s time is up. Ask whoever sent it for a fresh link.
        </p>
      </article>
    )
  }
  {
    state === "missing" && (
      <article class="share">
        <p class="kicker reveal" style="--i:1">Not found</p>
        <h1 class="filename reveal" style="--i:2">Nothing here.</h1>
        <p class="plain reveal" style="--i:3">
          This link doesn&rsquo;t match any file — it may have been deleted by its sender.
        </p>
      </article>
    )
  }
</Layout>

<style>
  .file-rows {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .file-rows li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  .file-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-dl {
    flex: none;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
  }
  .file-dl:hover {
    text-decoration: underline;
  }
  .share {
    padding: clamp(2.5rem, 8vw, 5rem) 0 0;
    max-width: 36rem;
  }
  .filename {
    font-family: var(--serif);
    font-weight: 580;
    font-size: clamp(1.9rem, 5.5vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 2rem;
    word-break: break-word;
  }
  /* Spec-sheet facts: hairline-marked columns, no boxes. */
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1.2rem 1.4rem;
    margin: 0 0 2.6rem;
  }
  .facts div {
    border-left: 1px solid var(--line-2);
    padding-left: 0.85rem;
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0.3rem 0 0;
    font-weight: 600;
    font-size: 1.02rem;
  }
  .actions {
    margin: 0 0 1.1rem;
  }
  .btn-primary {
    font-size: 1.05rem;
    padding: 0.8rem 1.6rem;
  }
  .dl-size {
    color: color-mix(in oklch, var(--on-accent) 75%, transparent);
    font-size: 0.78rem;
  }
  .quiet {
    color: var(--ink-3);
  }
  .plain {
    color: var(--ink-2);
    max-width: 38ch;
    font-size: 1.05rem;
  }
</style>
